# Every env variant, including the timestamped backups taken before a config
# edit -- those hold the database password, the API keys and the JWT private
# key, and were previously not ignored. The example file is the one
# deliberate exception and is already tracked.
.env*
!.env.production.example
node_modules
__pycache__/
*.pyc
*.pyo
*.pyd
*build/
*dist/
*.egg-info/
*.so
.pytest_cache/
test_ci.db

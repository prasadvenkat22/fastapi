# Every env variant, including the timestamped backups taken before a config
# edit -- those hold the database password, the API keys and the JWT private
# key, and were previously not ignored. The example file is the one
# deliberate exception and is already tracked.
.env*
!.env.production.example
node_modules
__pycache__/
*.pyc
*.pyo
*.pyd
*build/
*dist/
*.egg-info/
*.so
.pytest_cache/
test_ci.db

# Forward-collected option-chain snapshots for the volatility-surface refit.
# Data, not source: append-only, grows every session, and reproducible only
# by waiting. See scripts/capture_chain.py.
data/

# Written on the server by scripts/issue_cert.sh (HTTPS block and the shared
# location set) and the disabled copies of retired server configs. Per-host
# output, never source.
app/nginx/conf.d/*-ssl.conf
app/nginx/conf.d/*-locations.inc
app/nginx/conf.d/*.disabled*

# Operator-tuned trading settings and their audit trail, written on the
# droplet by /trading/settings and scripts/settings.py. Per-host state.
trading_overrides.env
trading_overrides.log
.trading_overrides.*.tmp

# orphans.py runtime state (section 232)
orphan_peaks.json
orphan_watch_now.json

# host crontab copy for /trading/schedule (section 240)
crontab.snapshot

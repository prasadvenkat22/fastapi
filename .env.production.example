# Production Environment Configuration
# Copy this file to .env.production and update values before deployment
# IMPORTANT: Never commit .env.production with real secrets to git
# IMPORTANT: Do NOT use quotes around values - Docker Compose treats them literally

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@pgdb:5432/postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=postgres

# pgAdmin (only used with --profile debug)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=YOUR_SECURE_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=YOUR_SECURE_PASSWORD

# MongoDB Configuration
MONGODB_URL=mongodb://mongo:27017
DB_NAME=TENANT

# Application Configuration
APP_PORT=5000
PORT=5000

# JWT/Auth Configuration
secret=GENERATE_NEW_SECRET_WITH_openssl_rand_hex_32
algorithm=HS256
ACCESS_TOKEN_EXPIRES_IN=15
REFRESH_TOKEN_EXPIRES_IN=60
JWT_ALGORITHM=RS256
CLIENT_ORIGIN=https://yourdomain.com

# JWT Keys - Generate new keys for production!
# Generate with: openssl genrsa 512 | base64 -w 0
JWT_PRIVATE_KEY=YOUR_BASE64_ENCODED_PRIVATE_KEY
# Generate with: openssl rsa -pubout | base64 -w 0
JWT_PUBLIC_KEY=YOUR_BASE64_ENCODED_PUBLIC_KEY

# Claude (Anthropic) — used by GENAI for LLM calls
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Voyage AI — used by GENAI for embeddings
VOYAGE_API_KEY=YOUR_VOYAGE_API_KEY

# Tradier — used by the trading engine for market-breadth data ($ADDQ / $TICKQ)
TRADIER_API_KEY=YOUR_TRADIER_API_KEY
TRADIER_ENV=sandbox

# Trading engine — mocked broker, no real orders. TRADING_POSITION_BUDGET is
# total capital, not per-trade: only one position is open at a time and the
# worst case on a force-closed loser is the whole amount deployed.
TRADING_POSITION_BUDGET=6500      # matches the deployed server

# Share of the budget the opening trade may use; the rest funds scale-ins.
# Must stay below 1.0 or no cash remains and scale-ins can never fire.
# Because each scale-in doubles the position, the number that actually fits is
# capital-bound, not TRADING_MAX_SCALE_INS-bound:
#   0.40 -> 1 scale-in    0.25 -> 2 scale-ins    0.125 -> 3 scale-ins
# Watch the floor: a spread costs ~$200, so budget x fraction below that buys
# zero contracts and the engine silently never trades.
# SET IN THE DEPLOYED BLOCK BELOW, not here. This file used to set the key
# twice -- 0.4 here and 0.20 further down -- which is last-wins in most
# parsers and a coin flip in the rest.
TRADING_MAX_SCALE_INS=0

# Entries wait this long after the 09:30 bell so the opening auction's
# whipsaws aren't read as a trend. Position management is unaffected and runs
# from the first cycle. Combined with the 14:00 entry cutoff, the entry window
# is 09:45-14:00 ET.
TRADING_WARMUP_MINUTES=15

# Assumed QQQ daily move (% of spot), used to price time value in the spread
# model. ~1% is a normal day; raise it for a jumpier tape. This is the main
# knob controlling how fast P&L moves.
TRADING_DAILY_VOL_PCT=1.0

# Exit thresholds (% return on the spread's net debit). RISK_OFF is the
# tightened stop that applies only while macro sentiment is BAD.
# Global take-profit fallback. Each named strategy overrides it in
# trading_engine/playbook.py -- ATM_MOMENTUM targets 60% because an ATM
# structure maxes out near +163% and a 30% target would book the small win
# and discard the reason for choosing it. This value covers positions opened
# before per-strategy targets existed, and any whose window was retired.
TRADING_TAKE_PROFIT_PCT=30.0
TRADING_STOP_LOSS_PCT=-20.0
TRADING_RISK_OFF_STOP_LOSS_PCT=-13.0

# Halt NEW entries once the day's realized losses reach this share of the
# equity the session started with. Open positions are still managed. 0.25
# allows roughly two full stop-outs before the engine stands down for the day.
TRADING_MAX_DAILY_LOSS_PCT=0.06

# How long the headline read (RSS + Voyage + Claude) is reused before being
# refreshed. Breadth, VIX and TNX always recompute -- they are the velocity
# signals meant to catch sudden change. This lets the cycle interval and the
# macro cost move independently: at a 1-minute cadence an uncached macro pass
# would be ~390 Claude calls and 1,170 RSS fetches per session.
TRADING_MACRO_REFRESH_MINUTES=5

# Whether the RELAXED entry tier trades alongside STRICT. RELAXED drops only
# the RSI requirement, on the reasoning that a Bollinger pierce and an RSI
# extreme both measure "price is stretched" -- measured over a month, RSI
# removed 31 of 63 band pierces, taking opportunity from 2.8 to 1.5 a day
# against a market that offers about 2.8. Both tiers are attributed
# separately (ITM_GRINDER:STRICT vs ITM_GRINDER:RELAXED) so the scoreboard
# shows which is actually worth trading. Set false to revert to strict-only.
TRADING_RELAXED_ENTRIES=true

# Whether the MOMENTUM tier trades: a 20-period midline cross with MACD and
# trend agreeing -- "the trend just turned" rather than "price is stretched",
# so it catches moves that never reach a band. Deliberately not "rising RSI",
# which fired 21 times a day against a market offering ~2.8 real moves.
TRADING_MOMENTUM_ENTRIES=false

# TREND tier: MACD + trend + RSI extreme, with NO Bollinger requirement.
# Every other debit tier needs a band pierce, but Bollinger bands are built
# from a rolling 100-minute mean, so they drift with a trending market and a
# steady decline never pierces them -- they catch dislocations, not trends.
# Observed live: QQQ fell $11 and the engine refused a complete bearish setup
# for twelve straight cycles because the band had not pierced.
TRADING_TREND_ENTRIES=false

# CLEAN tier: all four structural rules aligned -- price vs 20 SMA, 9 EMA on
# the same side of it, price vs VWAP, and RSI mid-band and still moving. The
# most selective tier, checked first. Measured over a month it triggers 5.8
# times a day; the RSI band does 75% of the filtering, VWAP only 16%.
TRADING_CLEAN_ENTRIES=true

# RSI bands for CLEAN. Deliberately mid-range, not extreme: strength present
# but not exhausted, the opposite of the overbought/oversold snap-back idea.
TRADING_RSI_BULL_LOW=50.0
TRADING_RSI_BULL_HIGH=65.0
TRADING_RSI_BEAR_LOW=35.0
TRADING_RSI_BEAR_HIGH=48.0

# Bar size the indicators are computed on. 5-minute, not 1-minute: a
# 20-period Bollinger spans 100 minutes here versus 20, which matches how long
# positions are actually held. The same gates on 1-minute bars fired 18
# signals a day against ~2.8 tradeable moves. Risk stays on the 1-minute
# clock -- spot repricing and the 60s cycle -- so stops and the daily loss
# limit still react fast.
TRADING_BAR_INTERVAL=5m

# Trailing exits. With this on, a position reaching its window target ARMS a
# trail instead of selling: it runs while price keeps closing on the right
# side of the 5-minute 9 EMA, and exits when that breaks. Matters because an
# ATM spread tops out near +163% and booking at +60% forfeits most of what
# the structure was chosen for. Set false for fixed-target exits.
TRADING_TRAILING_EXITS=true

# Once a position has reached its target, give back at most this share of its
# BEST gain before closing. 0.15 means a peak of +70% exits near +59%.
# The 9 EMA trail alone did not cover this: it is a price trail and knows
# nothing about P&L, so a spread can hand back most of its gain while price
# is still on the right side of the 9 EMA. Whichever triggers first wins.
TRADING_TRAIL_GIVEBACK=0.20

# Full bid-ask width of the vertical, in dollars per spread; half is paid
# entering and half leaving. A $3-wide QQQ vertical quotes roughly $0.05-0.10
# wide, which is 3-4% of a position's whole value -- larger than the entire
# risk-off stop. Without this every recorded P&L was optimistic by that much.
# Set 0 to model frictionless fills (not realistic).
TRADING_SLIPPAGE_PER_SPREAD=0.05

# How far OTM the short leg of a credit vertical sits. Further out means a
# higher chance of expiring worthless but a smaller credit -- the one knob
# trading win rate against payout.
# 2.0, matching playbook.py. The 3.0 that stood here was the placement the
# 2026-08-24 sweep REJECTED: fixed $3 measured -11.85 a trade against -4.86
# for max(2sd, $2), collecting $0.07 and winning 8% of the time. Copying this
# file to .env.production would have shipped it.
TRADING_OTM_OFFSET=2.0
TRADING_OTM_SD_MULTIPLE=2.0

# Sizing. nodes.py defaults ENTRY_FRACTION to 0.10 and the deployed engine
# runs 0.20; section 38 records five sizing corrections in two days caused by
# exactly that gap between a default and the live value. Set it explicitly so
# the difference can never be silent again.
TRADING_ENTRY_FRACTION=0.20

# The morning ride's take-profit. nodes.py defaults this to 0 (off) while
# section 33 records DEPLOYED: 50 -- chosen deliberately as a risk preference
# over the expectancy-maximising arm, giving up ~$61/day for the best worst
# day of any arm tested (-717.60 against -985.80). Unset, the deployment
# silently runs the arm that was NOT chosen.
# 50, not 55. Swept 2026-09-06 at the DEPLOYED config ($10 wide, stall on),
# 60 sessions chain-priced -- the first sweep ever run against what actually
# trades. Per trade: off -23.31, 50% -22.27, 55% -30.09, 70% -21.66. 55 was
# the worst of five and had been moved off the recorded 50 without evidence.
# Read the caveat: the result is NON-MONOTONE (50 and 70 both 1:1.21, only 55
# dips to 1:1.03), so this restores a documented value rather than proving one.
TRADING_RIDE_TAKE_PROFIT=55

# MORNING GEOMETRY. These three are the drift-critical ones: the code
# defaults differ from the deployment, so an env rebuilt without them
# silently trades a configuration that has never been validated.
#
#   TRADING_MORNING_WIDTH     code 6.0   deployed 10.0
#   TRADING_MORNING_STOP_PCT  code -20   deployed -50
#   TRADING_STALL_MINUTES     code 0     deployed 5
#
# $10 wide with the long leg $2 ITM (short $8 OTM) is the placement that
# trades and the one the live record was earned on. Priced on the engine's
# own smile: long delta 0.71, short 0.01, net +0.70, debit 28% of width,
# structural R:R 1:2.61. It ranked 2nd of thirty in an independent placement
# grid (+70.55 a contract) behind only $1 ITM/$9 OTM (+77.41).
TRADING_MORNING_WIDTH=10.0

# -50, not -25. Swept 2026-09-06 at the deployed config, and MONOTONE across
# four levels -- looser is better on EV, win rate, payoff AND worst trade at
# the same time, which is not how a stop normally trades off:
#
#     -20%  62 tr  35% win  1:1.15  EV -32.39  worst -448.20
#     -25%  62 tr  37% win  1:1.03  EV -30.09  worst -448.20   <- was live
#     -35%  63 tr  38% win  1:1.05  EV -18.06  worst -298.80
#     -50%  53 tr  40% win  1:1.20  EV  -8.63  worst -157.40
#
# The tight stop manufactures its own worst days: it fires, the engine
# re-enters into the same adverse move, and the day compounds (62 trades
# against 53). All three live morning LOSSES were STOP_LOSS closes while both
# live WINNERS rode to a stall exit -- live and replay agree the structure
# wants to be left alone.
TRADING_MORNING_STOP_PCT=-50

# Stall exit. MEASURED OPTIMAL, do not drift: 0 min -49.44, 5 min -30.09,
# 10 min -49.18, 15 min -43.05. The two largest live wins (+478, +189) both
# exited on this rule, which the notes had admitted was never measured on
# this book.
TRADING_STALL_MINUTES=5
TRADING_STALL_GIVEBACK_PCT=3.3

# Section 43's overshoot fix. Re-runs the cycle every 10s while a position is
# open so an exit is not held hostage to the cron minute.
TRADING_EXIT_POLL_SECONDS=10

# Macro risk-off gates. Sentiment flips BAD if VIX is above the level ceiling
# OR has spiked by more than the % move from today's open.
TRADING_VIX_LEVEL_MAX=22.0
TRADING_VIX_SPIKE_PCT=10.0

# 10-year Treasury yield, judged on intraday velocity only (basis points from
# the 09:30 open). QQQ is long-duration, so rising yields compress its
# multiple. A typical session moves the 10Y 3-6bp; 8bp is a real move against
# a long tech position. One-sided: only a RISE forces risk-off.
# 4bp, not 8. Measured over a month of 5-minute history the 10Y's intraday
# peak never exceeded 4.3bp, so an 8bp gate could not fire and never did.
# 4bp reached on 3 of 22 sessions, and QQQ closed down on all three.
TRADING_TNX_SPIKE_BPS=4.0

# Breadth also flips sentiment BAD if the net advance/decline ratio has
# fallen this far from its peak over the trailing window, even while still
# net-positive. Windowed rather than session-anchored so a slow all-day
# drift doesn't read the same as a sudden mid-session break.
TRADING_BREADTH_COLLAPSE_RATIO=0.40
TRADING_BREADTH_WINDOW_MINUTES=30

# Production Settings
ENVIRONMENT=production
DEBUG=false

# ---------------------------------------------------------------------------
# Email (password resets and security notifications)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty and nothing is sent: helpers/mailer.py logs what it
# would have sent and returns False. Unconfigured is a supported state, so the
# forgot-password endpoint still works -- the link is written to the log
# instead of delivered, which is fine for testing and useless in production.
#
# GMAIL DOES NOT WORK ON THIS DROPLET. DigitalOcean blocks outbound ports 25,
# 465 and 587 at the network level -- verified 2026-08-23: the HOST, not just
# the container, times out connecting to smtp.gmail.com on all three, while
# ufw's OUTPUT policy is ACCEPT with no SMTP rules. Gmail offers no other
# port, so an App Password cannot help. The failure looks like
# "OSError: [Errno 101] Network is unreachable", never an auth error.
#
# PORT 2525 IS OPEN and is exactly what the transactional providers offer for
# hosts in this situation. Verified with a full EHLO + STARTTLS handshake to
# smtp.sendgrid.net, smtp-relay.brevo.com and smtp.mailgun.org. Pick one,
# create an API key, and set it below -- no code change, mailer.py is plain
# SMTP on purpose.
#
#   SendGrid  SMTP_HOST=smtp.sendgrid.net      SMTP_USER=apikey
#   Brevo     SMTP_HOST=smtp-relay.brevo.com   SMTP_USER=<your login>
#   Mailgun   SMTP_HOST=smtp.mailgun.org       SMTP_USER=<postmaster@domain>
#
# The other route is asking DigitalOcean support to lift the block, which
# they often decline and which takes days either way.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=2525
SMTP_USER=apikey
SMTP_PASSWORD=your-provider-api-key
SMTP_STARTTLS=true
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=DataIQ Systems

# Where the reset LINK points. Without it the email carries the raw token and
# instructions to POST it, because a link that goes nowhere is worse. No
# trailing slash. Use https once TLS is in place -- a reset link over plain
# http hands the token to anyone watching.
APP_BASE_URL=https://dataiqsystems.com

# How long a reset link lives, and how many an account may hold at once. The
# second is a mailbox limiter: without it anyone can make the public endpoint
# send unlimited mail to an address they do not own.
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_MAX_LIVE=3

# ---------------------------------------------------------------------------
# EXIT KNOBS ADDED 2026-09-03. All three are safe to leave unset -- each falls
# back to the behaviour that was already deployed. Notes sections 73 and 74.
# ---------------------------------------------------------------------------

# How wide a SHORT leg may be quoted, in dollars, before the orphan manager
# refuses to price an exit from it. Checked ALONGSIDE the proportional limit,
# and the kinder of the two wins.
#
# A percentage alone rejects every cheap option: a 0DTE short quoted 0.02/0.03
# is a one-cent market -- as tight as an option gets -- and 40% of its own mid.
# That is how a force close came to be blocked on a live QQQ credit spread for
# the last eleven minutes of its life.
TRADING_ORPHAN_MAX_LEG_SPREAD_ABS=0.05

# The stalled-peak timer for the AFTERNOON CREDIT trade, separately from the
# morning ride's. Unset, each falls back to TRADING_STALL_MINUTES and
# TRADING_STALL_GIVEBACK_PCT, which is what is deployed today.
#
# They shared one pair of knobs until now, so neither could be tuned without
# moving the other -- and the two rules want different timers. On the morning
# ride the profit curve tracks spot, so quiet means the move is done. On a
# 0DTE credit spread with spot sitting still, theta prints a new high nearly
# every cycle, so quiet means the underlying has come back toward the short
# and decay has stopped winning.
#
# MEASURED AND LEFT ALONE. Sixty sessions chain-calibrated separate the best
# setting from the worst by twelve dollars: the rule touches ten trades in
# three months. Section 76. The split exists so the question can be asked
# again later, not because the answer is currently interesting.
# TRADING_CREDIT_STALL_MINUTES=5
# TRADING_CREDIT_STALL_GIVEBACK_PCT=3.3

# No LOSS-TAKING before this time, New York. Empty disables the gate.
#
# The open is not a signal, it is a spread: the book is widest and the mark
# least trustworthy in the first stretch, so a structure can show -25% on a
# spread that has not moved, or print a peak and a giveback on two wide
# quotes in a row.
#
# GATED: the stop and the stall. LIVE from the first cycle: the ceiling at 90%
# of maximum, and the 15:45 force close. Taking max profit at 09:30 is fine;
# taking a loss at 09:30 is not, and they should not share a gate.
#
# Trades tail protection for noise immunity. These are debit spreads, so the
# loss is bounded by the premium paid rather than by the stop. Section 77.
TRADING_ORPHAN_HOLD_UNTIL=10:00

# Dollars of INTRINSIC given back from the peak before the orphan manager
# closes a position. 0 disables it, which is the default and what is deployed.
#
# This covers the band where the stall and the stop are both correctly silent:
# the stall will not sell while the mark is under entry, the stop will not sell
# while intrinsic is above entry, and a deep ITM spread is in both states at
# once. MU 995/1005 lost 1,255 of expiry value in five minutes inside it.
#
# It is a stop on the value AT EXPIRY rather than on the mark, so it will book
# a small mark loss to avoid a larger one. Unmeasured -- do not enable without
# running it through the harness first. Section 78.
# As a PERCENT OF THE STRUCTURE'S WIDTH -- no single dollar figure works
# across a book holding 3-wide and 30-wide spreads at once.
# TRADING_ORPHAN_INTRINSIC_GIVEBACK_PCT=10

# How long the intrinsic giveback must hold before it acts, in minutes. Any
# new intrinsic high clears the clock, so dip-recover-dip starts over.
#
# Without it the rule fires on the first cycle the threshold is crossed, which
# means it fires on NOISE: MU 990/1000 breathed 8.68-10.00 all afternoon
# against a 1.50 threshold, and a three-minute dip cost 2,050. A threshold
# alone cannot separate a wobble from a reversal -- the size of a wobble
# belongs to the underlying. Time can. Section 80.
TRADING_ORPHAN_GIVEBACK_CONFIRM_MIN=5

# Close EVERY position when account equity reaches this, regardless of expiry.
# 0 disables. A circuit breaker, not a stop: it asks whether the account can
# survive being wrong again, not whether a trade has failed. Overrides
# TRADING_ORPHAN_ACT_EXPIRY_DAY_ONLY, because when the floor is hit the
# weeklies are usually where the exposure is. Fails open on an unreadable
# equity -- a broker hiccup must not liquidate the book. Section 83.
#
# NOT DEPLOYED. Built and then withdrawn the same evening -- the capability is
# kept because the gap it covers is real (nothing in the ladder asks whether
# the ACCOUNT is solvent), but no value is set, so it cannot fire.
# TRADING_ACCOUNT_FLOOR=0

# The SLOW stop: a shallower level that must hold CONTINUOUSLY, clock reset
# the moment the mark recovers above it. 0 disables.
#
# ORPHAN_STOP_PCT is the FAST stop -- it fires on a touch, which is what a gap
# needs, and is set loose because anything tighter fires on the extrinsic
# swing an ITM spread carries all day. This catches what that misses: steady
# erosion that never reaches -40%.
#
# The duration test is the whole rule. The same -10% level costs 12,559 fired
# on a touch and gains 996 held for an hour. Section 87.
TRADING_ORPHAN_SLOW_STOP_PCT=-20
TRADING_ORPHAN_SLOW_STOP_MINUTES=30


# ============================================================================
# EVERYTHING ELSE THE DEPLOYED SERVER SETS  (captured 2026-09-06)
# ============================================================================
#
# Read from `docker exec app env` on the production droplet. Before this
# block this file named 40 of the 63 TRADING_ keys the engine actually
# runs on, so an env rebuilt from it dropped 43 settings to code
# defaults -- including the morning width, the stall exit and the exit
# poll interval. That is the same failure that put a $6 width and no
# stall exit into every sweep recorded in strategy_notes.txt.
#
# TRADING_LIVE_ORDERS is deliberately false here. The server runs true;
# a template that routes real orders the moment it is copied is not a
# template. Set it consciously, not by inheritance.
#
TRADING_BEARISH_START=09:45
TRADING_CREDIT_FINAL_TAKE_PROFIT=50.0
TRADING_CREDIT_SHORT_DELTA=0.25
TRADING_CREDIT_STALL_ARM=false
TRADING_CREDIT_START=14:00
TRADING_CREDIT_STOP_PCT=-600.0
TRADING_CREDIT_WIDTH=4.0
TRADING_ENABLED_WINDOWS=MORNING_DRIFT,AFTERNOON_CREDIT
TRADING_FADE_ENTRIES=true
TRADING_LIVE_ORDERS=false   # server runs true
TRADING_MACRO_LLM_GATE=false
TRADING_MANAGE_ORPHANS=true
TRADING_MANAGE_UNDERLYING=QQQ,NVDA,SNDK,CRWV,MRVL,PANW,MU,AVGO,DELL,WDC,STX
TRADING_MAX_CONSECUTIVE_LOSSES=3
TRADING_MAX_ORDER_CONTRACTS=5
TRADING_MIN_CREDIT=0.20
TRADING_MIN_GIVEBACK_PCT=10.0
TRADING_MOMENTUM_START=09:45
TRADING_ORDER_PREVIEW_ONLY=false
TRADING_ORPHAN_ACT_EXPIRY_DAY_ONLY=true
TRADING_ORPHAN_CEILING=0
TRADING_ORPHAN_INTRINSIC_GIVEBACK_PCT=0
TRADING_ORPHAN_LATER_TARGET_PCT=0.90
TRADING_ORPHAN_MANAGE_INFERRED=true
TRADING_ORPHAN_STALL_GIVEBACK_PCT=3.3
TRADING_ORPHAN_STALL_MINUTES=0
TRADING_ORPHAN_STOP_CONFIRM_MINUTES=0
TRADING_ORPHAN_STOP_PCT=-40
TRADING_ORPHAN_TARGET_RETURN_PCT=55
TRADING_RATCHET_ARM_PCT=32.0
TRADING_STALL_ON_CREDIT=true
TRADING_WATCH_ORPHANS=true
TRADING_WEEKLY_CLOSE_BY=15:30
TRADING_WEEKLY_LIVE=true
TRADING_WEEKLY_LIVE_CONTRACTS=1
TRADING_WEEKLY_LIVE_DELTA=0.25
TRADING_WEEKLY_LIVE_SYMBOLS=CRWV
TRADING_WEEKLY_LIVE_TARGET_PCT=50
TRADING_WEEKLY_LIVE_VARIANTS=CALL
TRADING_WEEKLY_SYMBOLS=AMZN,AVGO,CRWV,DELL,GOOGL,META,MRVL,MSFT,MU,NVDA,PANW,QQQ,SNDK,STX,WDC
TRADING_WIN_COOLDOWN_MINUTES=30
TRADING_ZONE_ENTRIES=true
TRADING_ZONE_REQUIRE_MACRO=false

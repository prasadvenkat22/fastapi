# Production Environment Configuration
# Copy this file to .env.production and update values before deployment
# IMPORTANT: Never commit .env.production with real secrets to git
# IMPORTANT: Do NOT use quotes around values - Docker Compose treats them literally

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@pgdb:5432/postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=postgres

# pgAdmin (only used with --profile debug)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=YOUR_SECURE_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=YOUR_SECURE_PASSWORD

# MongoDB Configuration
MONGODB_URL=mongodb://mongo:27017
DB_NAME=TENANT

# Application Configuration
APP_PORT=5000
PORT=5000

# JWT/Auth Configuration
secret=GENERATE_NEW_SECRET_WITH_openssl_rand_hex_32
algorithm=HS256
ACCESS_TOKEN_EXPIRES_IN=15
REFRESH_TOKEN_EXPIRES_IN=60
JWT_ALGORITHM=RS256
CLIENT_ORIGIN=https://yourdomain.com

# JWT Keys - Generate new keys for production!
# Generate with: openssl genrsa 512 | base64 -w 0
JWT_PRIVATE_KEY=YOUR_BASE64_ENCODED_PRIVATE_KEY
# Generate with: openssl rsa -pubout | base64 -w 0
JWT_PUBLIC_KEY=YOUR_BASE64_ENCODED_PUBLIC_KEY

# Claude (Anthropic) — used by GENAI for LLM calls
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Voyage AI — used by GENAI for embeddings
VOYAGE_API_KEY=YOUR_VOYAGE_API_KEY

# Tradier — used by the trading engine for market-breadth data ($ADDQ / $TICKQ)
TRADIER_API_KEY=YOUR_TRADIER_API_KEY
TRADIER_ENV=sandbox

# Trading engine — mocked broker, no real orders. TRADING_POSITION_BUDGET is
# total capital, not per-trade: only one position is open at a time and the
# worst case on a force-closed loser is the whole amount deployed.
TRADING_POSITION_BUDGET=1000

# Share of the budget the opening trade may use; the rest funds scale-ins.
# Must stay below 1.0 or no cash remains and scale-ins can never fire.
# Because each scale-in doubles the position, the number that actually fits is
# capital-bound, not TRADING_MAX_SCALE_INS-bound:
#   0.40 -> 1 scale-in    0.25 -> 2 scale-ins    0.125 -> 3 scale-ins
# Watch the floor: a spread costs ~$200, so budget x fraction below that buys
# zero contracts and the engine silently never trades.
TRADING_ENTRY_FRACTION=0.4
TRADING_MAX_SCALE_INS=3

# Entries wait this long after the 09:30 bell so the opening auction's
# whipsaws aren't read as a trend. Position management is unaffected and runs
# from the first cycle. Combined with the 14:00 entry cutoff, the entry window
# is 09:45-14:00 ET.
TRADING_WARMUP_MINUTES=15

# Assumed QQQ daily move (% of spot), used to price time value in the spread
# model. ~1% is a normal day; raise it for a jumpier tape. This is the main
# knob controlling how fast P&L moves.
TRADING_DAILY_VOL_PCT=1.0

# Exit thresholds (% return on the spread's net debit). RISK_OFF is the
# tightened stop that applies only while macro sentiment is BAD.
# Global take-profit fallback. Each named strategy overrides it in
# trading_engine/playbook.py -- ATM_MOMENTUM targets 60% because an ATM
# structure maxes out near +163% and a 30% target would book the small win
# and discard the reason for choosing it. This value covers positions opened
# before per-strategy targets existed, and any whose window was retired.
TRADING_TAKE_PROFIT_PCT=30.0
TRADING_STOP_LOSS_PCT=-10.0
TRADING_RISK_OFF_STOP_LOSS_PCT=-5.0

# Halt NEW entries once the day's realized losses reach this share of the
# equity the session started with. Open positions are still managed. 0.25
# allows roughly two full stop-outs before the engine stands down for the day.
TRADING_MAX_DAILY_LOSS_PCT=0.25

# How long the headline read (RSS + Voyage + Claude) is reused before being
# refreshed. Breadth, VIX and TNX always recompute -- they are the velocity
# signals meant to catch sudden change. This lets the cycle interval and the
# macro cost move independently: at a 1-minute cadence an uncached macro pass
# would be ~390 Claude calls and 1,170 RSS fetches per session.
TRADING_MACRO_REFRESH_MINUTES=5

# Whether the RELAXED entry tier trades alongside STRICT. RELAXED drops only
# the RSI requirement, on the reasoning that a Bollinger pierce and an RSI
# extreme both measure "price is stretched" -- measured over a month, RSI
# removed 31 of 63 band pierces, taking opportunity from 2.8 to 1.5 a day
# against a market that offers about 2.8. Both tiers are attributed
# separately (ITM_GRINDER:STRICT vs ITM_GRINDER:RELAXED) so the scoreboard
# shows which is actually worth trading. Set false to revert to strict-only.
TRADING_RELAXED_ENTRIES=true

# Macro risk-off gates. Sentiment flips BAD if VIX is above the level ceiling
# OR has spiked by more than the % move from today's open.
TRADING_VIX_LEVEL_MAX=22.0
TRADING_VIX_SPIKE_PCT=10.0

# 10-year Treasury yield, judged on intraday velocity only (basis points from
# the 09:30 open). QQQ is long-duration, so rising yields compress its
# multiple. A typical session moves the 10Y 3-6bp; 8bp is a real move against
# a long tech position. One-sided: only a RISE forces risk-off.
TRADING_TNX_SPIKE_BPS=8.0

# Breadth also flips sentiment BAD if the net advance/decline ratio has
# fallen this far from its peak over the trailing window, even while still
# net-positive. Windowed rather than session-anchored so a slow all-day
# drift doesn't read the same as a sudden mid-session break.
TRADING_BREADTH_COLLAPSE_RATIO=0.40
TRADING_BREADTH_WINDOW_MINUTES=30

# Production Settings
ENVIRONMENT=production
DEBUG=false

# Production Environment Configuration
# Copy this file to .env.production and update values before deployment
# IMPORTANT: Never commit .env.production with real secrets to git
# IMPORTANT: Do NOT use quotes around values - Docker Compose treats them literally

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:YOUR_SECURE_PASSWORD@pgdb:5432/postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=postgres

# pgAdmin (only used with --profile debug)
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=YOUR_SECURE_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=YOUR_SECURE_PASSWORD

# MongoDB Configuration
MONGODB_URL=mongodb://mongo:27017
DB_NAME=TENANT

# Application Configuration
APP_PORT=5000
PORT=5000

# JWT/Auth Configuration
secret=GENERATE_NEW_SECRET_WITH_openssl_rand_hex_32
algorithm=HS256
ACCESS_TOKEN_EXPIRES_IN=15
REFRESH_TOKEN_EXPIRES_IN=60
JWT_ALGORITHM=RS256
CLIENT_ORIGIN=https://yourdomain.com

# JWT Keys - Generate new keys for production!
# Generate with: openssl genrsa 512 | base64 -w 0
JWT_PRIVATE_KEY=YOUR_BASE64_ENCODED_PRIVATE_KEY
# Generate with: openssl rsa -pubout | base64 -w 0
JWT_PUBLIC_KEY=YOUR_BASE64_ENCODED_PUBLIC_KEY

# Claude (Anthropic) — used by GENAI for LLM calls
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Voyage AI — used by GENAI for embeddings
VOYAGE_API_KEY=YOUR_VOYAGE_API_KEY

# Tradier — used by the trading engine for market-breadth data ($ADDQ / $TICKQ)
TRADIER_API_KEY=YOUR_TRADIER_API_KEY
TRADIER_ENV=sandbox

# Production Settings
ENVIRONMENT=production
DEBUG=false
